{
  "name": "marketing-team-task-bot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check-manifest": "node scripts/check-migration-manifest.mjs",
    "db:test-postgrest-errors": "node scripts/test-postgrest-business-errors.mjs",
    "db:test-content-os-auth": "psql \"$CONTENT_OS_AUTH_TEST_DB_URL\" -v ON_ERROR_STOP=1 -f scripts/test-content-os-auth.sql && node scripts/test-content-os-auth-concurrency.mjs",
    "db:test-team-permissions": "node scripts/test-team-permissions.mjs",
    "telegram:configure": "node --env-file-if-exists=.env.local scripts/configure-telegram.mjs",
    "telegram:status": "node --env-file-if-exists=.env.local scripts/configure-telegram.mjs --status",
    "test:watch": "vitest",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "types:cloudflare": "wrangler types"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "@vinext/cloudflare": "1.1.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "server-only": "0.0.1",
    "vinext": "1.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@eslint/compat": "2.1.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.0.2",
    "eslint-config-next": "16.4.2",
    "supabase": "2.116.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.0",
    "wrangler": "4.151.0"
  },
  "type": "module"
}
