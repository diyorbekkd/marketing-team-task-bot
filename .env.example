# Public application URL. Keep all other values server-only.
APP_URL=http://localhost:3000

# Supabase server configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names are also accepted during migration:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Telegram server configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# These can be populated after the bot receives real updates:
TELEGRAM_GROUP_ID=
HEAD_TELEGRAM_USER_ID=

# Fixed product timezone
APP_TIMEZONE=Asia/Tashkent
