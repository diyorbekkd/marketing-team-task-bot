# Public application URL. Keep all other values server-only.
APP_URL=http://localhost:3000

# Supabase server configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names are also accepted during migration:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Telegram server configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# These can be populated after the bot receives real updates:
TELEGRAM_GROUP_ID=
HEAD_TELEGRAM_USER_ID=

# Fixed product timezone
APP_TIMEZONE=Asia/Tashkent

# Protects Vercel Cron routes. Vercel sends this as Authorization: Bearer ...
CRON_SECRET=

# Content OS server-to-server auth (see docs/CONTENT_OS_SERVICE_AUTH.md).
# Defaults to disabled. Even with CONTENT_OS_SERVICE_AUTH_ENABLED=true and a
# real secret set, no request can resolve to a real actor yet: the actor
# resolver fails closed until Codex's external_identity_links schema lands
# and a real ExternalActorResolver replaces the built-in
# SchemaNotReadyExternalActorResolver. Do not enable in production yet.
CONTENT_OS_SERVICE_AUTH_ENABLED=false
CONTENT_OS_SERVICE_SECRET=
