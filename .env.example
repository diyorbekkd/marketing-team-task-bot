# Public application URL. Keep all other values server-only.
APP_URL=http://localhost:3000

# Supabase server configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names are also accepted during migration:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Telegram server configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEB_CLIENT_ID=
TELEGRAM_WEB_CLIENT_SECRET=
# These can be populated after the bot receives real updates:
TELEGRAM_GROUP_ID=
HEAD_TELEGRAM_USER_ID=
# Optional: separate video-materials supergroup and its Syomka forum topic.
# Set both together only after the bot can post in that topic. Leave blank to disable.
VIDEO_MEDIA_CHAT_ID=
VIDEO_MEDIA_TOPIC_ID=

# Fixed product timezone
APP_TIMEZONE=Asia/Tashkent

# Protects Vercel Cron routes. Vercel sends this as Authorization: Bearer ...
CRON_SECRET=

# OpenAI API project key from the organization linked to ChatGPT Pro API credits.
# Set only on the server; never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
